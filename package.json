{
  "name": "squirrel-switch",
  "version": "1.12.0",
  "private": false,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @squirrel-switch/server --filter @squirrel-switch/web dev",
    "desktop": "pnpm --filter @squirrel-switch/desktop start",
    "dev:server": "pnpm --filter @squirrel-switch/server dev",
    "dev:web": "pnpm --filter @squirrel-switch/web dev",
    "build": "node scripts/build.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:mac:app": "node scripts/package-mac.mjs --no-zip",
    "package:win": "node scripts/package-win.mjs",
    "set-version": "node scripts/set-version.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "mcp:install": "node scripts/chatgpt-mcp-tunnel.mjs install",
    "mcp:start": "node scripts/chatgpt-mcp-tunnel.mjs start",
    "mcp:status": "node scripts/chatgpt-mcp-tunnel.mjs status",
    "mcp:refresh": "node scripts/chatgpt-mcp-tunnel.mjs refresh",
    "mcp:stop": "node scripts/chatgpt-mcp-tunnel.mjs stop",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
